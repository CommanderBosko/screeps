{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "moduleResolution": "node10",
    "lib": ["ES2017", "dom"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "sourceMap": true,
    "baseUrl": "./src",
    "rootDir": "./src",
    "outDir": "./dist",
    "typeRoots": ["./node_modules/@types"],
    "types": ["screeps", "node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"],
  "exclude": ["watch.js", "push.js"]
}
